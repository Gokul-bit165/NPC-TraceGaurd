    {
      "parameters": {
        "jsCode": "// Accepts ONE event or an array. Works with Entra / Google / IdP exports (field aliases handled).\nconst body = $input.first().json.body ?? $input.first().json;\nconst list = Array.isArray(body) ? body : (body.events ?? [body]);\nconst out = list.map(e => ({\n  user_id: String(e.user_id ?? e.userPrincipalName ?? e.email ?? e.user ?? \"\"),\n  ts: new Date(e.ts ?? e.createdDateTime ?? e.timestamp ?? Date.now()).toISOString(),\n  ip: e.ip ?? e.ipAddress ?? \"\",\n  country: e.country ?? e.location?.countryOrRegion ?? \"\",\n  city: e.city ?? e.location?.city ?? \"\",\n  device: String(e.device ?? e.deviceDetail?.operatingSystem ?? \"\").toLowerCase(),\n  success: e.success ?? (e.status?.errorCode === 0) ?? true,\n  is_attack_ip: false\n})).filter(x => x.user_id);\nreturn [{ json: { batch: out } }];"
      },
      "name": "Map to TraceGuard fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.TRACEGUARD_URL || 'http://host.docker.internal:8000') }}/api/ingest/logins",
